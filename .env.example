# Supabase project URL and Publishable key. Never use Secret / service_role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backward compatible public anon key. Not required if Publishable key is set.
VITE_SUPABASE_ANON_KEY=

# Legacy display setting. Authenticated screens use stores.name from the database.
VITE_STORE_NAME=
